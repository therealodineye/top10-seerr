# Overseerr / Seerr Server Configuration
# Copy this file to '.env' before running or let the web app create it automatically.

# The public or local URL of your Overseerr/Seerr instance (with trailing slash)
SEERR_URL=https://your-overseerr-url.com/

# Your Overseerr/Seerr API Key (found in Settings -> General)
SEERR_API_KEY=your_overseerr_api_key_here

# Your Overseerr/Seerr sign-in credentials (used for bulk requests sync)
SEERR_EMAIL=your_overseerr_email_here
SEERR_PASSWORD=your_overseerr_password_here


# 🛡️ Request Approval & Dedicated Bot User (Recommended)
# To ensure that media requests made through this application are not automatically approved (keeping you in complete control of what actually gets downloaded by Radarr/Sonarr), it is highly recommended to set up a dedicated low-permission "bot user" in Overseerr:

# Create the Bot User in Seerr:

# Go to Overseerr/Seerr → Users → Add User.
# Create a local account with a unique email and password (e.g., seerrsync-bot@local.domain).
# Do not grant any Auto-Approve permissions to this user.
# Note the email and password—you will enter them in the application settings drawer!
# How it Works:

# When you submit sync requests, the web app authenticates as this dedicated low-permission bot account.
# The requests will be successfully submitted to Overseerr and put into the Pending approval queue rather than auto-importing immediately. This allows administrators to review and approve downloads individually!


# 🤖 48-Hour Pinned Automation Background Sync
# Automatically scrapes flixpatrol charts and requests movies/TV shows from a specified platform + country selection in the background every 48 hours.

# Enable background pinned list sync automation (true / false)
AUTOMATION_ENABLED=false

# Target platform slug: netflix, amazon-prime, disney, hbo-max, apple-tv, paramount-plus
AUTOMATION_PLATFORM=netflix

# Target country slug (e.g. world, norway, united-states, etc. matching flixpatrol slugs)
AUTOMATION_COUNTRY=world

# Media type to auto sync: both, movie, tv
AUTOMATION_MEDIA_TYPE=both

# 🔔 Discord Webhook Integration
# Provide a Discord webhook URL to receive notifications about synchronization operations
NOTIFICATION_DISCORD_WEBHOOK=


